# Reference values only. The Python server reads environment variables directly;
# it does not automatically load this file. Do not place real secrets here.
RETAILX_HOST=127.0.0.1
RETAILX_PORT=8000
# Optional local data location. Leave unset to use ./data.
# RETAILX_DATA_DIR=D:\RetailXData
# Optional pretrained model name/path; first use may download model weights.
# RETAILX_MODEL=yolo26n.pt
